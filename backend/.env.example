# CreatorPulse AI - Environment Configuration Example
ENVIRONMENT=prototype
DATA_STORAGE=json_mock
PORT=8000
HOST=127.0.0.1

# Content Studio & LLM Provider (mock, gemini, openai, anthropic)
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here

# YouTube Data API v3 (for live YouTube video comments in VibeCheck AI)
YOUTUBE_API_KEY=your_youtube_api_key_here
