# CreatorPulse AI - Backend Environment Configuration Example
PORT=8000
HOST=0.0.0.0

# Allowed CORS origins (comma-separated).
# On Render, add your Vercel URL (e.g. https://creatorpulse-ai.vercel.app).
# By default, all https://*.vercel.app preview/production domains and localhost are allowed automatically.
ALLOWED_ORIGINS=https://creatorpulse-ai.vercel.app,http://localhost:5173

# YouTube Data API v3 key (for fetching live YouTube video comments in VibeCheck AI)
# Get a free key at https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here
