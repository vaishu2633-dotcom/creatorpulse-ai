# CreatorPulse AI Frontend - Environment Configuration Example
#
# Production (Vercel):
# Set VITE_API_URL to your deployed Render backend service URL.
# Example: https://creatorpulse-ai-backend.onrender.com
#
# Local Development:
# Leave VITE_API_URL empty so requests route through Vite's local dev server proxy (http://127.0.0.1:8000).
VITE_API_URL=
